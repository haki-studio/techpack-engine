{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/svg2dst/Dockerfile",
    "watchPatterns": ["services/svg2dst/**", "engine/**", "scripts/svg2dst.py", "requirements.txt", "factory.json"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
