+def family_raster(P, bb, shape):
+    """1 = stripes + rope cords, 2 = foam (crests, shades, hollows, curl cords), 3 = drops - from the art (what each area IS)"""
+    from PIL import Image, ImageDraw
+    im = Image.new("L", shape[::-1], 0); d = ImageDraw.Draw(im)
+    code = lambda g: 1 if g in ("WV", "RP") else (3 if g in ("DR", "DR-b") else 2)
+    for r in sorted(D[P], key=lambda r: r.get("layer", 0)):
+        for q in WR.polys_of(r["geom"]):
+            d.polygon([((x - bb[0]) * PPM, (y - bb[1]) * PPM) for x, y in q.exterior.coords], fill=code(r["grp"]))
+    return np.asarray(im)
+
+def visible_segments(segs, shape, w_mm=0.45, keep=0.3):
+    """the stitches you SEE (what the live view and the founder judge): every segment drawn in sewing order on one raster,
+    later stitches over earlier ones; a segment is visible when >= keep of its own pixels survive on top. Underlay, padding
+    and travel under later fills drop out. Input = the DST(s) only."""
+    from PIL import Image, ImageDraw
+    im = Image.new("I", (shape[1], shape[0]), 0); d = ImageDraw.Draw(im); w = max(1, int(round(w_mm * PPM)))
+    exp = []
+    for i, (x0, y0, x1, y1) in enumerate(segs):
+        d.line([(x0 * PPM, y0 * PPM), (x1 * PPM, y1 * PPM)], fill=i + 1, width=w)
+        exp.append(max(1.0, np.hypot(x1 - x0, y1 - y0) * PPM * w))
+    cnt = np.bincount(np.asarray(im).ravel(), minlength=len(segs) + 1)[1:]
+    return [s_ for s_, c, e in zip(segs, cnt, exp) if c >= keep * e]
+
